# ===== Sleep Tracker Bot — приклад змінних оточення =====
# Скопіюйте цей файл у .env та заповніть реальними значеннями.
# НІКОЛИ не комітьте справжній .env у git!

# Токен бота від @BotFather (обовʼязково)
BOT_TOKEN=your-telegram-bot-token-here

# Telegram ID адміністраторів через кому (обовʼязково хоча б один)
# Дізнатися свій ID можна у бота @userinfobot
ADMIN_IDS=123456789

# ID групи, куди надсилаються квитанції про оплату для перевірки (опційно)
# Формат: відʼємне число, напр. -1001234567890
ADMIN_GROUP_ID=0

# Порт для веб-сервера (Render задає автоматично; локально можна лишити 8080)
PORT=8080

# Шлях до файлу з даними користувачів (обов'язково на Render!)
# Render використовує тимчасову файлову систему — вкажіть шлях на persistent disk:
# DATA_FILE=/var/data/sleep_ai_data.json
# Локально можна залишити значення за замовчуванням (sleep_ai_data.json у папці проєкту)
# DATA_FILE=sleep_ai_data.json

# Ключ OpenAI для справжнього ШІ-аналізу сну (рекомендовано).
# Без нього бот використовує безкоштовний провайдер g4f (менш стабільний).
# Отримати ключ: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Модель за замовчуванням (опційно):
# OPENAI_MODEL=gpt-4o-mini

# БЕЗКОШТОВНИЙ ключ Google Gemini (без картки, є безкоштовний тариф):
# Отримати: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# БЕЗКОШТОВНИЙ ключ Groq — найбільший безкоштовний тариф
# (14 400 запитів/день, дуже швидкий). Отримати: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
