# ===== Sleep Tracker Bot — приклад змінних оточення =====
# Скопіюйте цей файл у .env та заповніть реальними значеннями.
# НІКОЛИ не комітьте справжній .env у git!

# Токен бота від @BotFather (обовʼязково)
BOT_TOKEN=your-telegram-bot-token-here

# Telegram ID адміністраторів через кому (обовʼязково хоча б один)
# Дізнатися свій ID можна у бота @userinfobot
ADMIN_IDS=123456789

# ID групи, куди надсилаються квитанції про оплату для перевірки (опційно)
# Формат: відʼємне число, напр. -1001234567890
ADMIN_GROUP_ID=0

# Порт для веб-сервера (Render задає автоматично; локально можна лишити 8080)
PORT=8080
